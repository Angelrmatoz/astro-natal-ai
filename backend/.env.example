# Variables del backend y de backend/docker-compose.db.yml.
# Copia este archivo a backend/.env solo si no usas Infisical.
# .env no se versiona; Spring no lo lee automáticamente.

# PostgreSQL / Docker Compose
POSTGRES_DB=astro_natal
POSTGRES_USER=astro
POSTGRES_PASSWORD=astro_dev_password
DB_HOST=localhost
DB_PORT=5432

# Backend
BACKEND_PORT=8080
JWT_SECRET=
JWT_TTL=PT24H
JWT_ISSUER=astro-natal-ai

# Servicios externos
GEOCODING_URL=https://geocoding-api.open-meteo.com
ASTRO_ENGINE_URL=http://localhost:3001
