# Copia este archivo a .env para sobreescribir los defaults de desarrollo.
# .env no se versiona.
# Docker Compose vive en backend/docker-compose.db.yml y lee backend/.env
# (o las variables inyectadas por Infisical).

POSTGRES_DB=astro_natal
POSTGRES_USER=astro
POSTGRES_PASSWORD=astro_dev_password
DB_PORT=5432

# Backend: exporta estas variables o inyéctalas con Infisical.
# Spring NO lee .env automáticamente; .env es para Docker Compose.
DB_HOST=localhost
# Obligatorio. Mínimo 32 bytes. Se inyecta por entorno o Infisical.
JWT_SECRET=
JWT_TTL=PT24H
JWT_ISSUER=astro-natal-ai
GEOCODING_URL=https://geocoding-api.open-meteo.com
ASTRO_ENGINE_URL=http://localhost:3001
